# Copy to .env for local use, or paste these into your host's environment UI.
# NOTHING in this file is a real secret - it is the shape, not the values.

# --- required in a deployed environment ---
# Neon gives you a URL like:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# The JDBC form drops the credentials into their own variables:
DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=your_neon_user
DATABASE_PASSWORD=your_neon_password

# --- optional: personalisation ---
# Unset or empty => deterministic template rendering, service still fully works.
# Get a free key at https://console.groq.com (no card).
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_REQUEST_TIMEOUT=4s

# --- optional: tuning ---
RATE_LIMIT_PER_RECIPIENT=5
RATE_LIMIT_WINDOW=60s
LOG_FORMAT=ecs

# --- optional: ship logs to a hosted backend ---
# Better Stack: Sources -> your source -> Connect, gives an ingest host and a
# source token. Axiom or any endpoint taking `POST` of a JSON array with a
# bearer token works identically.
#
# Both empty => no appender is attached at all: no background thread, no network
# calls. stdout keeps its structured output regardless.
LOG_SHIP_URL=https://sNNNNNNN.eu-central-1a.betterstackdata.com
LOG_SHIP_TOKEN=your_source_token
